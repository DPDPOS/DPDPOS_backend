  @@index([organizationId])
  @@index([organizationId, status])
  @@index([controlId])
  @@index([assignedTo])
  @@index([organizationId, findingSource, dedupeKey])
  @@index([complianceFindingId])
  @@index([agentId])
  @@index([assessmentId])
  @@map("violations")
}

