model AssessmentDocument {
  id             String   @id @default(uuid()) @db.Uuid
  assessmentId   String   @map("assessment_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  versionNumber  Int      @map("version_number")
  fileName       String   @map("file_name")
  fileType       String   @map("file_type")
  documentType   String   @default("OTHER") @map("document_type")
  mimeType       String?  @map("mime_type")
  storageKey     String?  @map("storage_key")
  fileSizeBytes  Int?     @map("file_size_bytes")
  uploadStatus   String   @default("READY") @map("upload_status")
  contentBase64  String?  @map("content_base64") @db.Text
  extractedText  String?  @map("extracted_text") @db.Text
  checksum       String
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  assessment Assessment @relation(fields: [assessmentId], references: [id])

  @@index([assessmentId, versionNumber])
  @@index([organizationId])
  @@map("assessment_documents")
}

model QuestionnaireAnswer {
  id             String   @id @default(uuid()) @db.Uuid
  assessmentId   String   @map("assessment_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  versionNumber  Int      @map("version_number")
  questionCode   String   @map("question_code")
  valueJson      Json     @map("value_json")
  answeredBy     String?  @map("answered_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  assessment Assessment @relation(fields: [assessmentId], references: [id])

  @@unique([assessmentId, versionNumber, questionCode])
  @@index([organizationId])
  @@map("questionnaire_answers")
}

model CliToken {
  id             String    @id @default(uuid()) @db.Uuid
  /** Null for org-scoped vendor/TPRM CLI tokens (not tied to an assessment). */
  assessmentId   String?   @map("assessment_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  label          String
  tokenHash      String    @unique @map("token_hash")
  tokenPrefix    String    @map("token_prefix")
  expiresAt      DateTime? @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  lastUsedAt     DateTime? @map("last_used_at")
  createdBy      String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")

  assessment Assessment? @relation(fields: [assessmentId], references: [id])

  @@index([assessmentId])
  @@index([organizationId])
  @@map("cli_tokens")
}

model ScanJob {
  id             String        @id @default(uuid()) @db.Uuid
  assessmentId   String        @map("assessment_id") @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  versionNumber  Int           @map("version_number")
  targetType     String        @map("target_type")
  targetPath     String        @map("target_path")
  cliVersion     String        @map("cli_version")
  status         ScanJobStatus @default(PENDING)
  findingsCount  Int           @default(0) @map("findings_count")
  /** Optional AI enrichment context from dpdp-cli --ai (Groq, etc.).
   * Informational only — does NOT affect deterministic evaluation. */
  aiContext      Json?         @map("ai_context")
  startedAt      DateTime      @default(now()) @map("started_at")
  finishedAt     DateTime?     @map("finished_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  assessment Assessment  @relation(fields: [assessmentId], references: [id])
  findings   CliFinding[]

  @@index([assessmentId, versionNumber])
  @@index([organizationId])
  @@map("scan_jobs")
}

model CliFinding {
  id                String   @id @default(uuid()) @db.Uuid
  assessmentId      String   @map("assessment_id") @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  scanJobId         String   @map("scan_job_id") @db.Uuid
  versionNumber     Int      @map("version_number")
  sourceType        String   @map("source_type")
  location          String
  findingType       String   @map("finding_type")
  excerpt           String?  @db.Text
  confidence        Float
  controlCandidates String[] @map("control_candidates")
  sourceHash        String?  @map("source_hash")
  createdAt         DateTime @default(now()) @map("created_at")

  assessment Assessment @relation(fields: [assessmentId], references: [id])
  scanJob    ScanJob    @relation(fields: [scanJobId], references: [id])

  @@index([assessmentId, versionNumber])
  @@index([scanJobId])
  @@index([organizationId])
  @@map("cli_findings")
}

model AssessmentControlResult {
  id                    String            @id @default(uuid()) @db.Uuid
  assessmentId          String            @map("assessment_id") @db.Uuid
  organizationId        String            @map("organization_id") @db.Uuid
  versionNumber         Int               @map("version_number")
  controlCode           String            @map("control_code")
  frameworkControlCode  String?           @map("framework_control_code")
  status                ControlEvalStatus
  severity              String            @default("MEDIUM")
  reasoning             String            @db.Text
  evidenceRefs          Json              @default("[]") @map("evidence_refs")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  assessment Assessment @relation(fields: [assessmentId], references: [id])

  @@unique([assessmentId, versionNumber, controlCode])
  @@index([organizationId])
  @@index([frameworkControlCode])
  @@map("assessment_control_results")
}

model AssessmentReport {
  id             String   @id @default(uuid()) @db.Uuid
  assessmentId   String   @map("assessment_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  versionNumber  Int      @map("version_number")
  score          Float
  summary        Json
  results        Json
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  assessment Assessment @relation(fields: [assessmentId], references: [id])

  @@unique([assessmentId, versionNumber])
  @@index([organizationId])
  @@map("assessment_reports")
}

model AssessmentAuditEvent {
  id             String              @id @default(uuid()) @db.Uuid
  assessmentId   String              @map("assessment_id") @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  actorUserId    String?             @map("actor_user_id") @db.Uuid
  actorType      AssessmentActorType @map("actor_type")
  action         String
  objectType     String              @map("object_type")
  objectId       String?             @map("object_id")
  payloadHash    String              @map("payload_hash")
  eventHash      String              @map("event_hash")
  prevEventHash  String?             @map("prev_event_hash")
  createdAt      DateTime            @default(now()) @map("created_at")

  assessment Assessment @relation(fields: [assessmentId], references: [id])

  @@index([assessmentId, createdAt])
  @@index([organizationId])
  @@map("assessment_audit_events")
}

// =============================================================================
// Agent Control Plane
// =============================================================================

enum DeploymentTier {
  COMMUNITY
  ENTERPRISE
  MANAGED
}

enum AgentState {
  PENDING
  ACTIVE
  DEGRADED
  OFFLINE
  REVOKED
}

enum AgentTaskType {
  DISCOVERY
  DSR_ACCESS
  DSR_CORRECTION
  DSR_ERASURE
  CONSENT_SNAPSHOT
  COMPLIANCE_SCAN
}

enum AgentTaskStatus {
  PENDING
  DISPATCHED
  ACKNOWLEDGED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
  ESCALATED
}

enum FindingSource {
  AGENT
  ASSESSMENT
  VALIDATION
  MANUAL
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FindingStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum DataAssetSource {
  MANUAL
  AGENT
  IMPORT
}

enum ErasureDispatchMode {
  MANUAL
  AGENT
  WEBHOOK
}

enum LedgerActorType {
  USER
  AGENT
  SYSTEM
}

model OrganizationControlPlaneSettings {
  id                    String         @id @default(uuid()) @db.Uuid
  organizationId        String         @unique @map("organization_id") @db.Uuid
  deploymentTier        DeploymentTier @default(COMMUNITY) @map("deployment_tier")
  agentMtlsRequired     Boolean        @default(false) @map("agent_mtls_required")
  discoveryEnabled      Boolean        @default(true) @map("discovery_enabled")
  dsrDispatchEnabled    Boolean        @default(false) @map("dsr_dispatch_enabled")
  consentSyncEnabled    Boolean        @default(false) @map("consent_sync_enabled")
  scopeProfileJson      Json?          @map("scope_profile_json")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("organization_control_plane_settings")
}

model AgentEnrollmentToken {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  tokenHash        String    @unique @map("token_hash")
  tokenPrefix      String    @map("token_prefix")
  label            String?
  scopeProfileJson Json?     @map("scope_profile_json")
  maxUses          Int       @default(1) @map("max_uses")
  useCount         Int       @default(0) @map("use_count")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  lastUsedAt       DateTime? @map("last_used_at")
  createdBy        String?   @map("created_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  agents      Agent[]

  @@index([organizationId, expiresAt])
  @@map("agent_enrollment_tokens")
}

model Agent {
  id                String     @id @default(uuid()) @db.Uuid
  organizationId    String     @map("organization_id") @db.Uuid
  enrollmentTokenId String?    @map("enrollment_token_id") @db.Uuid
  name              String
  state             AgentState @default(PENDING)
  agentVersion      String     @map("agent_version")
  instanceKey       String     @map("instance_key")
  platform          String?
  hostname          String?
  capabilitiesJson  Json?      @map("capabilities_json")
  scopeProfileJson  Json?      @map("scope_profile_json")
  metadataJson      Json?      @map("metadata_json")
  enrolledAt        DateTime   @default(now()) @map("enrolled_at")
  lastHeartbeatAt   DateTime?  @map("last_heartbeat_at")
  revokedAt         DateTime?  @map("revoked_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  organization    Organization          @relation(fields: [organizationId], references: [id])
  enrollmentToken AgentEnrollmentToken? @relation(fields: [enrollmentTokenId], references: [id])
  certificates    AgentCertificate[]
  tasks           AgentTask[]
  dataSystems     DataSystem[]
  dataAssets      DataAsset[]
  catalogRevisions CatalogRevision[]
  complianceFindings ComplianceFinding[]
  violations      Violation[]

  @@unique([organizationId, instanceKey])
  @@index([organizationId, state])
  @@index([lastHeartbeatAt])
  @@map("agents")
}

model AgentCertificate {
  id              String    @id @default(uuid()) @db.Uuid
  agentId         String    @map("agent_id") @db.Uuid
  serialNumber    String    @unique @map("serial_number")
  fingerprintSha256 String  @unique @map("fingerprint_sha256")
  certificatePem  String    @map("certificate_pem") @db.Text
  issuedAt        DateTime  @default(now()) @map("issued_at")
  expiresAt       DateTime  @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  replacedById    String?   @map("replaced_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")

  agent      Agent             @relation(fields: [agentId], references: [id])
  replacedBy AgentCertificate? @relation("CertificateRotation", fields: [replacedById], references: [id])
  replaces   AgentCertificate[] @relation("CertificateRotation")

  @@index([agentId, expiresAt])
  @@map("agent_certificates")
}

model AgentTask {
  id                   String          @id @default(uuid()) @db.Uuid
  organizationId       String          @map("organization_id") @db.Uuid
  agentId               String          @map("agent_id") @db.Uuid
  dataSubjectRequestId  String?         @map("data_subject_request_id") @db.Uuid
  type                   AgentTaskType
  status                 AgentTaskStatus @default(PENDING)
  dedupeKey              String          @map("dedupe_key")
  payloadJson            Json            @map("payload_json")
  resultJson             Json?           @map("result_json")
  failureReason          String?         @map("failure_reason") @db.Text
  attemptCount           Int             @default(0) @map("attempt_count")
  availableAt            DateTime        @default(now()) @map("available_at")
  dispatchedAt           DateTime?       @map("dispatched_at")
  acknowledgedAt         DateTime?       @map("acknowledged_at")
  completedAt            DateTime?       @map("completed_at")
  expiresAt              DateTime?       @map("expires_at")
  requestedBy            String?         @map("requested_by") @db.Uuid
  correlationId          String?         @map("correlation_id")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  organization       Organization        @relation(fields: [organizationId], references: [id])
  agent              Agent               @relation(fields: [agentId], references: [id])
  dataSubjectRequest DataSubjectRequest? @relation(fields: [dataSubjectRequestId], references: [id])
  erasureChecklistItem ErasureChecklistItem?

  @@unique([organizationId, dedupeKey])
  @@index([agentId, status, availableAt])
  @@index([dataSubjectRequestId])
  @@map("agent_tasks")
}

model DataSystem {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  agentId            String   @map("agent_id") @db.Uuid
  externalId         String   @map("external_id")
  name               String
  systemType         String   @map("system_type")
  connectorKey       String?  @map("connector_key")
  environment        String?
  location           String?
  metadataJson       Json?    @map("metadata_json")
  firstDiscoveredAt  DateTime @default(now()) @map("first_discovered_at")
  lastDiscoveredAt   DateTime @default(now()) @map("last_discovered_at")
  deletedAt          DateTime? @map("deleted_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organization       Organization       @relation(fields: [organizationId], references: [id])
  agent              Agent              @relation(fields: [agentId], references: [id])
  dataAssets         DataAsset[]
  dataFields         DataField[]
  identityGraphEdges IdentityGraphEdge[]
  complianceFindings ComplianceFinding[]

  @@unique([organizationId, agentId, externalId])
  @@index([organizationId, systemType])
  @@map("data_systems")
}

model DataField {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  systemId          String   @map("system_id") @db.Uuid
  dataAssetId       String?  @map("data_asset_id") @db.Uuid
  externalId        String   @map("external_id")
  name              String
  path              String?
  dataType          String?  @map("data_type")
  nullable          Boolean?
  pii               Boolean  @default(false)
  piiCategory       String?  @map("pii_category")
  confidence        Float?
  tagsJson          Json?    @map("tags_json")
  metadataJson      Json?    @map("metadata_json")
  firstDiscoveredAt DateTime @default(now()) @map("first_discovered_at")
  lastDiscoveredAt  DateTime @default(now()) @map("last_discovered_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  system       DataSystem   @relation(fields: [systemId], references: [id])
  dataAsset    DataAsset?   @relation(fields: [dataAssetId], references: [id])

  @@unique([systemId, externalId])
  @@index([organizationId, pii])
  @@index([dataAssetId])
  @@map("data_fields")
}

model CatalogRevision {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  agentId           String   @map("agent_id") @db.Uuid
  revision          Int
  schemaVersion     String   @map("schema_version")
  reportHash        String   @map("report_hash")
  reportJson        Json     @map("report_json")
  summaryJson       Json?    @map("summary_json")
  discoveredAt      DateTime @map("discovered_at")
  receivedAt        DateTime @default(now()) @map("received_at")
  createdAt         DateTime @default(now()) @map("created_at")

  organization       Organization        @relation(fields: [organizationId], references: [id])
  agent              Agent               @relation(fields: [agentId], references: [id])
  complianceFindings ComplianceFinding[]

  @@unique([agentId, revision])
  @@unique([agentId, reportHash])
  @@index([organizationId, receivedAt])
  @@map("catalog_revisions")
}

model IdentityGraphEdge {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  systemId           String   @map("system_id") @db.Uuid
  sourceIdentityHash String   @map("source_identity_hash")
  targetIdentityHash String   @map("target_identity_hash")
  edgeType           String   @map("edge_type")
  confidence         Float?
  evidenceJson       Json?    @map("evidence_json")
  firstSeenAt        DateTime @default(now()) @map("first_seen_at")
  lastSeenAt         DateTime @default(now()) @map("last_seen_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  system       DataSystem   @relation(fields: [systemId], references: [id])

  @@unique([organizationId, systemId, sourceIdentityHash, targetIdentityHash, edgeType])
  @@index([organizationId, sourceIdentityHash])
  @@index([organizationId, targetIdentityHash])
  @@map("identity_graph_edges")
}

model ComplianceFinding {
  id                String          @id @default(uuid()) @db.Uuid
  organizationId    String          @map("organization_id") @db.Uuid
  agentId           String?         @map("agent_id") @db.Uuid
  systemId          String?         @map("system_id") @db.Uuid
  dataAssetId       String?         @map("data_asset_id") @db.Uuid
  catalogRevisionId String?         @map("catalog_revision_id") @db.Uuid
  source            FindingSource
  sourceKey         String?         @map("source_key")
  dedupeKey         String          @map("dedupe_key")
  ruleCode          String          @map("rule_code")
  title             String
  description       String?         @db.Text
  severity          FindingSeverity
  status            FindingStatus   @default(OPEN)
  evidenceJson      Json?           @map("evidence_json")
  firstSeenAt       DateTime        @default(now()) @map("first_seen_at")
  lastSeenAt        DateTime        @default(now()) @map("last_seen_at")
  resolvedAt        DateTime?       @map("resolved_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  organization    Organization     @relation(fields: [organizationId], references: [id])
  agent           Agent?           @relation(fields: [agentId], references: [id])
  system          DataSystem?      @relation(fields: [systemId], references: [id])
  dataAsset       DataAsset?       @relation(fields: [dataAssetId], references: [id])
  catalogRevision CatalogRevision? @relation(fields: [catalogRevisionId], references: [id])
  violations      Violation[]

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, status, severity])
  @@index([agentId])
  @@index([systemId])
  @@index([dataAssetId])
  @@map("compliance_findings")
}

model EvidenceLedgerEntry {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  sequence        BigInt
  actorType       LedgerActorType @map("actor_type")
  actorId         String?         @map("actor_id")
  action          String
  entityType      String          @map("entity_type")
  entityId        String          @map("entity_id")
  payloadHash     String          @map("payload_hash")
  previousHash    String?         @map("previous_hash")
  entryHash       String          @map("entry_hash")
  signature       String?         @db.Text
  metadataJson    Json?           @map("metadata_json")
  occurredAt      DateTime        @map("occurred_at")
  createdAt       DateTime        @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, sequence])
  @@unique([organizationId, entryHash])
  @@index([organizationId, entityType, entityId])
  @@map("evidence_ledger_entries")
}

model Plugin {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String?  @map("organization_id") @db.Uuid
  pluginKey       String   @map("plugin_key")
  version         String
  name            String
  description     String?
  manifestJson    Json     @map("manifest_json")
  artifactUri     String   @map("artifact_uri")
  artifactSha256  String   @map("artifact_sha256")
  signature       String   @db.Text
  enabled         Boolean  @default(true)
  publishedAt     DateTime @default(now()) @map("published_at")
  createdBy       String?  @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, pluginKey, version])
  @@index([pluginKey, version])
  @@map("plugins")
}

model Rulepack {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String?  @map("organization_id") @db.Uuid
  rulepackKey     String   @map("rulepack_key")
  version         String
  name            String
  framework       String?
  manifestJson    Json     @map("manifest_json")
  rulesJson       Json     @map("rules_json")
  contentSha256   String   @map("content_sha256")
  signature       String   @db.Text
  enabled         Boolean  @default(true)
  publishedAt     DateTime @default(now()) @map("published_at")
  createdBy       String?  @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, rulepackKey, version])
  @@index([rulepackKey, version])
  @@map("rulepacks")
}
