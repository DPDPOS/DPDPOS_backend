// =============================================================================
// Developer B — Inventory
// =============================================================================

enum DataAssetStatus {
  ACTIVE
  ARCHIVED
}

enum DataSensitivity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model DataAsset {
  id String @id @default(uuid()) @db.Uuid

  organizationId String  @map("organization_id") @db.Uuid
  departmentId   String? @map("department_id") @db.Uuid
  ownerUserId    String? @map("owner_user_id") @db.Uuid

  assetName   String          @map("asset_name")
  assetType   String          @map("asset_type")
  category    String
  sensitivity DataSensitivity

  description String?

  storageLocation String? @map("storage_location")
  retentionPeriod String? @map("retention_period")

  status DataAssetStatus @default(ACTIVE)

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  department Department? @relation(fields: [departmentId], references: [id])

  owner User? @relation("DataAssetOwner", fields: [ownerUserId], references: [id])

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([departmentId])
  @@map("data_assets")
}
