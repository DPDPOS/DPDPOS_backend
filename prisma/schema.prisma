generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Developer A — Core Platform + Governance + Outbox
// =============================================================================

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum FrameworkStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ControlStatus {
  NOT_STARTED
  IN_PROGRESS
  IMPLEMENTED
  VERIFIED
}

model Organization {
  id                         String             @id @default(uuid()) @db.Uuid
  name                       String
  industry                   String?
  companySize                String?            @map("company_size")
  operatingRegion            String?            @map("operating_region")
  companyType                String?            @map("company_type")
  maturityLevel              String?            @map("maturity_level")
  isSignificantDataFiduciary Boolean            @default(false) @map("is_significant_data_fiduciary")
  status                     OrganizationStatus @default(ACTIVE)
  createdBy                  String?            @map("created_by") @db.Uuid
  updatedBy                  String?            @map("updated_by") @db.Uuid
  createdAt                  DateTime           @default(now()) @map("created_at")
  updatedAt                  DateTime           @updatedAt @map("updated_at")
  deletedAt                  DateTime?          @map("deleted_at")

  users                User[]
  roles                Role[]
  departments          Department[]
  frameworks           Framework[]
  controls             Control[]
  requirements         Requirement[]
  refreshSessions      RefreshSession[]
  outboxEvents         OutboxEvent[]
  dataAssets           DataAsset[]
  processingActivities ProcessingActivity[]
  notices              Notice[]
  consentRecords       ConsentRecord[]
  dataSubjectRequests  DataSubjectRequest[]
  validationRules      ValidationRule[]
  validationRuns       ValidationRun[]
  validationResults    ValidationResult[]
  violations           Violation[]
  evidenceFiles        EvidenceFile[]
  auditLogs            AuditLog[]
  reports              Report[]
  notifications        Notification[]
  aiUsageLogs          AiUsageLog[]

  @@map("organizations")
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  organizationId  String     @map("organization_id") @db.Uuid
  email           String
  name            String
  passwordHash    String?    @map("password_hash")
  status          UserStatus @default(INVITED)
  mfaEnabled      Boolean    @default(false) @map("mfa_enabled")
  mfaSecretEnc    String?    @map("mfa_secret_enc")
  inviteTokenHash String?    @map("invite_token_hash")
  inviteExpiresAt DateTime?  @map("invite_expires_at")
  lastLoginAt     DateTime?  @map("last_login_at")
  createdBy       String?    @map("created_by") @db.Uuid
  updatedBy       String?    @map("updated_by") @db.Uuid
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  organization      Organization     @relation(fields: [organizationId], references: [id])
  userRoles         UserRole[]
  headedDepartments Department[]     @relation("DepartmentHead")
  refreshSessions   RefreshSession[]
  ownedDataAssets   DataAsset[]      @relation("DataAssetOwner")
  assignedRequests  DataSubjectRequest[] @relation("DataSubjectRequestAssignee")
  assignedViolations Violation[]         @relation("ViolationAssignee")

  @@unique([organizationId, email])
  @@index([organizationId, status])
  @@index([inviteTokenHash])
  @@map("users")
}

model Role {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  description    String?
  permissions    String[]  @default([])
  isSystemRole   Boolean   @default(false) @map("is_system_role")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  userRoles    UserRole[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

model UserRole {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  assignedBy     String?  @map("assigned_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([organizationId])
  @@map("user_roles")
}

model Department {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  headUserId     String?   @map("head_user_id") @db.Uuid
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  headUser     User?        @relation("DepartmentHead", fields: [headUserId], references: [id])
  dataAssets   DataAsset[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("departments")
}

model Framework {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  name            String
  status          FrameworkStatus @default(DRAFT)
  industryProfile String?         @map("industry_profile")
  maturityLevel   String?         @map("maturity_level")
  isSdf           Boolean         @default(false) @map("is_sdf")
  roadmapJson     Json?           @map("roadmap_json")
  publishedAt     DateTime?       @map("published_at")
  createdBy       String?         @map("created_by") @db.Uuid
  updatedBy       String?         @map("updated_by") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")

  organization Organization  @relation(fields: [organizationId], references: [id])
  controls     Control[]
  requirements Requirement[]

  @@index([organizationId, status])
  @@map("frameworks")
}

model Control {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  frameworkId    String        @map("framework_id") @db.Uuid
  code           String
  title          String
  description    String?
  ownerUserId    String?       @map("owner_user_id") @db.Uuid
  dueAt          DateTime?     @map("due_at")
  status         ControlStatus @default(NOT_STARTED)
  legalBasisRef  String?       @map("legal_basis_ref")
  createdBy      String?       @map("created_by") @db.Uuid
  updatedBy      String?       @map("updated_by") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  organization Organization  @relation(fields: [organizationId], references: [id])
  framework    Framework     @relation(fields: [frameworkId], references: [id])
  requirements Requirement[]
  evidenceFiles EvidenceFile[]

  @@unique([frameworkId, code])
  @@index([organizationId, frameworkId])
  @@map("controls")
}

model Requirement {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  frameworkId    String    @map("framework_id") @db.Uuid
  controlId      String?   @map("control_id") @db.Uuid
  code           String
  title          String
  description    String?
  legalBasisRef  String?   @map("legal_basis_ref")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  framework    Framework    @relation(fields: [frameworkId], references: [id])
  control      Control?     @relation(fields: [controlId], references: [id])

  @@unique([frameworkId, code])
  @@index([organizationId, frameworkId])
  @@map("requirements")
}

model RefreshSession {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @map("token_hash")
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  userAgent      String?   @map("user_agent")
  ipAddress      String?   @map("ip_address")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_sessions")
}

model OutboxEvent {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  eventType      String    @map("event_type")
  payload        Json
  actorUserId    String?   @map("actor_user_id") @db.Uuid
  correlationId  String?   @map("correlation_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  publishedAt    DateTime? @map("published_at")
  attempts       Int       @default(0)
  lockedAt       DateTime? @map("locked_at")
  lockToken      String?   @map("lock_token")
  availableAt    DateTime? @map("available_at")
  lastError      String?   @map("last_error") @db.Text

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([publishedAt, createdAt])
  @@index([organizationId])
  @@index([availableAt, publishedAt])
  @@map("outbox_events")
}

// =============================================================================
// Developer B / C tables — owned by other streams; add via their migrations.
// Placeholders (do not implement here):
//   data_assets, processing_activities, notices, consent_records,
//   data_subject_requests, validation_rules, validation_runs, validation_results,
//   violations, remediation_tasks, evidence_files, reports, notifications,
//   ai_usage_logs, audit_logs
// =============================================================================

// =============================================================================
// Developer B — Inventory
// =============================================================================

enum DataAssetStatus {
  ACTIVE
  ARCHIVED
}

enum DataSensitivity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model DataAsset {
  id String @id @default(uuid()) @db.Uuid

  organizationId String  @map("organization_id") @db.Uuid
  departmentId   String? @map("department_id") @db.Uuid
  ownerUserId    String? @map("owner_user_id") @db.Uuid

  assetName   String          @map("asset_name")
  assetType   String          @map("asset_type")
  category    String
  sensitivity DataSensitivity

  description String?

  storageLocation String? @map("storage_location")
  retentionPeriod String? @map("retention_period")

  status DataAssetStatus @default(ACTIVE)

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  department Department? @relation(fields: [departmentId], references: [id])

  owner User? @relation("DataAssetOwner", fields: [ownerUserId], references: [id])

  processingActivities ProcessingActivity[]
  consentRecords      ConsentRecord[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([departmentId])
  @@map("data_assets")
}

model ProcessingActivity {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid
  dataAssetId    String @map("data_asset_id") @db.Uuid

  purpose       String
  sourceSystem  String? @map("source_system")
  recipientType String? @map("recipient_type")
  processorName String? @map("processor_name")
  legalBasis    String? @map("legal_basis")
  retentionRule String? @map("retention_rule")
  notes         String?

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  dataAsset DataAsset @relation(fields: [dataAssetId], references: [id])

  @@index([organizationId])
  @@index([dataAssetId])
  @@map("processing_activities")
}

// =============================================================================
// Developer B — Consent
// =============================================================================

enum ConsentState {
  GRANTED
  WITHDRAWN
}

model Notice {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  title         String
  version       Int      @default(1)
  content       String
  effectiveFrom DateTime? @map("effective_from")
  publishedBy   String?  @map("published_by") @db.Uuid

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  consentRecords ConsentRecord[]

  @@unique([organizationId, title, version])
  @@index([organizationId])
  @@map("notices")
}

model ConsentRecord {
  id String @id @default(uuid()) @db.Uuid

  organizationId       String       @map("organization_id") @db.Uuid
  dataSubjectIdentifier String      @map("data_subject_identifier")
  noticeId             String?      @map("notice_id") @db.Uuid
  dataAssetId          String?      @map("data_asset_id") @db.Uuid

  purpose      String
  consentState ConsentState @default(GRANTED) @map("consent_state")
  grantedAt    DateTime     @default(now()) @map("granted_at")
  withdrawnAt  DateTime?    @map("withdrawn_at")
  proofFileId  String?      @map("proof_file_id")

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  notice Notice? @relation(fields: [noticeId], references: [id])

  dataAsset DataAsset? @relation(fields: [dataAssetId], references: [id])

  @@index([organizationId])
  @@index([dataSubjectIdentifier])
  @@index([noticeId])
  @@index([dataAssetId])
  @@map("consent_records")
}

// =============================================================================
// Developer B — Rights
// =============================================================================

enum DataSubjectRequestType {
  ACCESS
  CORRECTION
  COMPLETION
  UPDATING
  ERASURE
  GRIEVANCE_REDRESSAL
  NOMINATION
}

enum DataSubjectRequestStatus {
  SUBMITTED
  ASSIGNED
  IN_PROGRESS
  RESPONDED
  REJECTED
  CLOSED
}

model DataSubjectRequest {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  requestType        DataSubjectRequestType @map("request_type")
  requesterReference String                 @map("requester_reference")
  status             DataSubjectRequestStatus @default(SUBMITTED)
  assignedTo         String?                @map("assigned_to") @db.Uuid

  openedAt DateTime  @default(now()) @map("opened_at")
  dueAt    DateTime? @map("due_at")
  closedAt DateTime? @map("closed_at")

  resolutionSummary String? @map("resolution_summary")

  version Int @default(1)

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  assignee User? @relation("DataSubjectRequestAssignee", fields: [assignedTo], references: [id])

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([assignedTo])
  @@index([requestType])
  @@map("data_subject_requests")
}

// =============================================================================
// Developer B — Validations
// =============================================================================

enum RuleSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RuleCategory {
  NOTICE
  CONSENT
  RETENTION
  RIGHTS
}

enum ValidationTriggerType {
  MANUAL
  SCHEDULED
}

enum ValidationRunStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum ValidationResultStatus {
  PASS
  FAIL
  SKIPPED
  ERROR
}

model ValidationRule {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  ruleCode      String       @map("rule_code")
  title         String
  description   String?
  legalBasisRef String?      @map("legal_basis_ref")
  severity      RuleSeverity @default(MEDIUM)
  category      RuleCategory
  activeFlag    Boolean      @default(true) @map("active_flag")
  version       Int          @default(1)

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  results ValidationResult[]

  @@unique([organizationId, ruleCode])
  @@index([organizationId])
  @@index([organizationId, activeFlag])
  @@map("validation_rules")
}

model ValidationRun {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  triggerType  ValidationTriggerType @map("trigger_type")
  triggeredBy  String?               @map("triggered_by") @db.Uuid
  status       ValidationRunStatus   @default(PENDING)
  startedAt    DateTime              @default(now()) @map("started_at")
  finishedAt   DateTime?             @map("finished_at")
  durationMs   Int?                  @map("duration_ms")

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  organization Organization  @relation(fields: [organizationId], references: [id])

  results ValidationResult[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("validation_runs")
}

model ValidationResult {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid
  runId          String @map("run_id") @db.Uuid
  ruleId         String @map("rule_id") @db.Uuid

  ruleCode      String @map("rule_code")
  resultStatus  ValidationResultStatus @map("result_status")
  explanation   String?
  score         Int?
  evidenceRequiredFlag Boolean @default(false) @map("evidence_required_flag")
  controlId     String? @map("control_id") @db.Uuid

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  organization Organization  @relation(fields: [organizationId], references: [id])
  run          ValidationRun @relation(fields: [runId], references: [id])
  rule         ValidationRule @relation(fields: [ruleId], references: [id])

  violations Violation[]

  @@unique([runId, ruleId])
  @@index([organizationId])
  @@index([runId])
  @@map("validation_results")
}

// =============================================================================
// Developer B — Violations
// =============================================================================

enum ViolationStatus {
  OPEN
  TRIAGE
  ASSIGNED
  IN_PROGRESS
  PENDING_EVIDENCE
  VALIDATED
  CLOSED
  ARCHIVED
}

model Violation {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  validationResultId String? @map("validation_result_id") @db.Uuid
  severity           RuleSeverity
  title              String
  description        String?
  status             ViolationStatus @default(OPEN)
  assignedTo         String?         @map("assigned_to") @db.Uuid

  openedAt  DateTime  @default(now()) @map("opened_at")
  dueAt     DateTime? @map("due_at")
  closedAt  DateTime? @map("closed_at")

  resolutionSummary   String? @map("resolution_summary")
  evidenceRequiredFlag Boolean @default(false) @map("evidence_required_flag")

  version Int @default(1)

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  validationResult ValidationResult? @relation(fields: [validationResultId], references: [id])

  assignee User? @relation("ViolationAssignee", fields: [assignedTo], references: [id])

  evidenceFiles EvidenceFile[]

  @@unique([organizationId, validationResultId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([assignedTo])
  @@map("violations")
}

// =============================================================================
// Developer C — Evidence
// =============================================================================

enum EvidenceStatus {
  UPLOADED
  TAGGED
  MAPPED
  UNDER_REVIEW
  APPROVED
  LOCKED
}

model EvidenceFile {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  fileName     String         @map("file_name")
  storageKey   String         @map("storage_key")
  mimeType     String         @map("mime_type")
  fileHash     String?        @map("file_hash")
  fileSizeBytes Int?          @map("file_size_bytes")
  description  String?
  tags         String[]       @default([])
  status       EvidenceStatus @default(UPLOADED)

  controlId   String? @map("control_id") @db.Uuid
  violationId String? @map("violation_id") @db.Uuid

  uploadedBy  String? @map("uploaded_by") @db.Uuid
  reviewedBy  String? @map("reviewed_by") @db.Uuid
  approvedBy  String? @map("approved_by") @db.Uuid
  lockedAt    DateTime? @map("locked_at")
  expiresAt   DateTime? @map("expires_at")

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  control      Control?     @relation(fields: [controlId], references: [id])
  violation    Violation?   @relation(fields: [violationId], references: [id])

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([controlId])
  @@index([violationId])
  @@map("evidence_files")
}

// =============================================================================
// Developer C — Audit
// =============================================================================

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  actorUserId   String  @map("actor_user_id") @db.Uuid
  actionType    String  @map("action_type")
  entityType    String  @map("entity_type")
  entityId      String  @map("entity_id")
  beforeJson    Json?   @map("before_json")
  afterJson     Json?   @map("after_json")
  ipAddress     String? @map("ip_address")
  userAgent     String? @map("user_agent")
  correlationId String? @map("correlation_id")

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, actionType])
  @@index([organizationId, actorUserId])
  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

// =============================================================================
// Developer C — Reports
// =============================================================================

enum ReportStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED
}

enum ReportFormat {
  PDF
  CSV
  EXCEL
}

enum ReportType {
  COMPLIANCE_SUMMARY
  BOARD_PACK
  VIOLATION_REPORT
  EVIDENCE_REPORT
  VALIDATION_REPORT
  CONSENT_REPORT
  RIGHTS_REPORT
  AUDIT_REPORT
}

model Report {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  reportType   ReportType   @map("report_type")
  title        String
  status       ReportStatus @default(PENDING)
  format       ReportFormat @default(PDF)
  generatedBy  String       @map("generated_by") @db.Uuid
  storageKey   String?      @map("storage_key")
  parameters   Json?
  startedAt    DateTime?    @map("started_at")
  completedAt  DateTime?    @map("completed_at")
  errorMessage String?      @map("error_message")

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, reportType])
  @@map("reports")
}

// =============================================================================
// Developer C — Notifications
// =============================================================================

enum NotificationChannel {
  EMAIL
  IN_APP
  SLACK
  TEAMS
  WEBHOOK
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

model Notification {
  id String @id @default(uuid()) @db.Uuid

  organizationId   String             @map("organization_id") @db.Uuid
  recipientUserId  String             @map("recipient_user_id") @db.Uuid
  notificationType String             @map("notification_type")
  channel          NotificationChannel @default(IN_APP)
  subject          String
  body             String
  status           NotificationStatus @default(PENDING)
  sentAt           DateTime?          @map("sent_at")
  readAt           DateTime?          @map("read_at")
  relatedEntityType String?           @map("related_entity_type")
  relatedEntityId   String?           @map("related_entity_id")
  retryCount       Int                @default(0) @map("retry_count")

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([recipientUserId])
  @@index([recipientUserId, status])
  @@index([organizationId, notificationType])
  @@map("notifications")
}

// =============================================================================
// Developer C — AI Usage Logs
// =============================================================================

enum AiUseCase {
  SUMMARIZE
  DRAFT
  EXPLAIN
  SEARCH
}

enum AiRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model AiUsageLog {
  id String @id @default(uuid()) @db.Uuid

  organizationId String        @map("organization_id") @db.Uuid
  requestedBy    String        @map("requested_by") @db.Uuid
  useCase        AiUseCase     @map("use_case")
  module         String
  entityType     String?       @map("entity_type")
  entityId       String?       @map("entity_id")
  promptVersion  String        @default("v1") @map("prompt_version")
  promptText     String?       @map("prompt_text") @db.Text
  resultText     String?       @map("result_text") @db.Text
  tokensIn       Int           @default(0) @map("tokens_in")
  tokensOut      Int           @default(0) @map("tokens_out")
  latencyMs      Int?          @map("latency_ms")
  estimatedCost  Float?        @map("estimated_cost")
  status         AiRequestStatus @default(PENDING)
  errorMessage   String?       @map("error_message")

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([organizationId, useCase])
  @@index([organizationId, status])
  @@map("ai_usage_logs")
}
