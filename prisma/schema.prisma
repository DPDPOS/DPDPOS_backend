generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Developer A — Core Platform + Governance + Outbox
// =============================================================================

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum IdentityMode {
  LOCAL
  LDAP_AD
  OIDC_ENTRA
  SAML_ADFS
  HYBRID
}

enum IdentityProviderType {
  LDAP
  OIDC
  SAML
}

enum UserAuthSource {
  LOCAL
  LDAP
  OIDC
  SAML
}

enum FrameworkStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ControlStatus {
  NOT_STARTED
  IN_PROGRESS
  IMPLEMENTED
  VERIFIED
}

enum RequirementStatus {
  NOT_STARTED
  IN_PROGRESS
  SATISFIED
  VERIFIED
  NOT_APPLICABLE
}

model Organization {
  id                         String             @id @default(uuid()) @db.Uuid
  name                       String
  industry                   String?
  companySize                String?            @map("company_size")
  operatingRegion            String?            @map("operating_region")
  companyType                String?            @map("company_type")
  maturityLevel              String?            @map("maturity_level")
  isSignificantDataFiduciary Boolean            @default(false) @map("is_significant_data_fiduciary")
  status                     OrganizationStatus @default(ACTIVE)
  /// Set once when the org finishes prerequisite DPDP onboarding (not per-login).
  onboardingCompletedAt      DateTime?          @map("onboarding_completed_at")
  onboardingCompletedBy      String?            @map("onboarding_completed_by") @db.Uuid
  createdBy                  String?            @map("created_by") @db.Uuid
  updatedBy                  String?            @map("updated_by") @db.Uuid
  createdAt                  DateTime           @default(now()) @map("created_at")
  updatedAt                  DateTime           @updatedAt @map("updated_at")
  deletedAt                  DateTime?          @map("deleted_at")

  users                User[]
  roles                Role[]
  departments          Department[]
  frameworks           Framework[]
  controls             Control[]
  requirements         Requirement[]
  refreshSessions      RefreshSession[]
  outboxEvents         OutboxEvent[]
  dataAssets           DataAsset[]
  processingActivities ProcessingActivity[]
  vendors              Vendor[]
  notices              Notice[]
  consentRecords       ConsentRecord[]
  dataSubjectRequests  DataSubjectRequest[]
  validationRules      ValidationRule[]
  validationRuns       ValidationRun[]
  validationResults    ValidationResult[]
  violations           Violation[]
  evidenceFiles        EvidenceFile[]
  auditLogs            AuditLog[]
  reports              Report[]
  notifications        Notification[]
  aiUsageLogs          AiUsageLog[]
  remediationTasks     RemediationTask[]
  assessments          Assessment[]
  onboardingAnswers    OrganizationOnboardingAnswer[]
  identitySettings     OrganizationIdentitySettings?
  identityProviders    IdentityProvider[]
  identityGroupRoleMaps IdentityGroupRoleMap[]
  identitySyncRuns     IdentitySyncRun[]
  controlPlaneSettings OrganizationControlPlaneSettings?
  agentEnrollmentTokens AgentEnrollmentToken[]
  agents               Agent[]
  agentTasks            AgentTask[]
  dataSystems           DataSystem[]
  dataFields            DataField[]
  catalogRevisions      CatalogRevision[]
  identityGraphEdges    IdentityGraphEdge[]
  complianceFindings    ComplianceFinding[]
  evidenceLedgerEntries EvidenceLedgerEntry[]
  plugins               Plugin[]
  rulepacks             Rulepack[]

  @@map("organizations")
}

/// Once-per-org DPDP discovery answers (prerequisite before assessments).
model OrganizationOnboardingAnswer {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  questionCode   String   @map("question_code")
  valueJson      Json     @map("value_json")
  answeredBy     String?  @map("answered_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, questionCode])
  @@index([organizationId])
  @@map("organization_onboarding_answers")
}

model User {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  email           String
  name            String
  passwordHash    String?        @map("password_hash")
  status          UserStatus     @default(INVITED)
  authSource      UserAuthSource @default(LOCAL) @map("auth_source")
  externalSubject String?        @map("external_subject")
  externalIssuer  String?        @map("external_issuer")
  upn             String?
  mfaEnabled      Boolean        @default(false) @map("mfa_enabled")
  mfaSecretEnc    String?        @map("mfa_secret_enc")
  inviteTokenHash String?        @map("invite_token_hash")
  inviteExpiresAt DateTime?      @map("invite_expires_at")
  lastLoginAt     DateTime?      @map("last_login_at")
  createdBy       String?        @map("created_by") @db.Uuid
  updatedBy       String?        @map("updated_by") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  deletedAt       DateTime?      @map("deleted_at")

  organization             Organization         @relation(fields: [organizationId], references: [id])
  userRoles                UserRole[]
  headedDepartments        Department[]         @relation("DepartmentHead")
  refreshSessions          RefreshSession[]
  ownedDataAssets          DataAsset[]          @relation("DataAssetOwner")
  ownedVendors             Vendor[]             @relation("VendorOwner")
  assignedRequests         DataSubjectRequest[] @relation("DataSubjectRequestAssignee")
  assignedViolations       Violation[]          @relation("ViolationAssignee")
  assignedRemediationTasks RemediationTask[]    @relation("RemediationTaskAssignee")

  @@unique([organizationId, email])
  @@unique([organizationId, externalSubject])
  @@index([organizationId, status])
  @@index([organizationId, upn])
  @@index([inviteTokenHash])
  @@map("users")
}

model OrganizationIdentitySettings {
  id                             String       @id @default(uuid()) @db.Uuid
  organizationId                 String       @unique @map("organization_id") @db.Uuid
  mode                           IdentityMode @default(LOCAL)
  enforceSso                     Boolean      @default(false) @map("enforce_sso")
  allowLocalBreakGlass           Boolean      @default(true) @map("allow_local_break_glass")
  disableLocalTotpWhenFederated  Boolean      @default(false) @map("disable_local_totp_when_federated")
  jitProvisioningEnabled         Boolean      @default(false) @map("jit_provisioning_enabled")
  defaultRoleName                String?      @map("default_role_name")
  createdAt                      DateTime     @default(now()) @map("created_at")
  updatedAt                      DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("organization_identity_settings")
}

model IdentityProvider {
  id               String               @id @default(uuid()) @db.Uuid
  organizationId   String               @map("organization_id") @db.Uuid
  type             IdentityProviderType
  name             String
  enabled          Boolean              @default(false)
  // OIDC / Entra
  issuer           String?
  clientId         String?              @map("client_id")
  clientSecretEnc  String?              @map("client_secret_enc")
  tenantId         String?              @map("tenant_id")
  scopes           String?              // space-separated
  /// Entra Conditional Access Authentication Context (C1-C99) that requires MFA.
  /// When configured, DPDPOS requests and verifies this value in the ID token.
  mfaAuthenticationContext String?      @map("mfa_authentication_context")
  // SAML
  entityId         String?              @map("entity_id")
  acsUrl           String?              @map("acs_url")
  idpMetadataUrl   String?              @map("idp_metadata_url")
  idpCertificate   String?              @map("idp_certificate") @db.Text
  // LDAP / Windows AD
  ldapHost         String?              @map("ldap_host")
  ldapPort         Int?                 @map("ldap_port")
  ldapUseTls       Boolean?             @map("ldap_use_tls")
  ldapBindDnEnc    String?              @map("ldap_bind_dn_enc")
  ldapBindPasswordEnc String?           @map("ldap_bind_password_enc")
  ldapBaseDn       String?              @map("ldap_base_dn")
  ldapUserFilter   String?              @map("ldap_user_filter")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  deletedAt        DateTime?            @map("deleted_at")

  organization Organization          @relation(fields: [organizationId], references: [id])
  groupMaps    IdentityGroupRoleMap[]
  syncRuns     IdentitySyncRun[]

  @@index([organizationId, type, enabled])
  @@map("identity_providers")
}

model IdentityGroupRoleMap {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  providerId        String   @map("provider_id") @db.Uuid
  externalGroupId   String   @map("external_group_id")
  externalGroupName String?  @map("external_group_name")
  roleId            String   @map("role_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id])
  provider     IdentityProvider @relation(fields: [providerId], references: [id])
  role         Role            @relation(fields: [roleId], references: [id])

  @@unique([organizationId, providerId, externalGroupId, roleId])
  @@index([organizationId, providerId])
  @@map("identity_group_role_maps")
}

model IdentitySyncRun {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  providerId     String    @map("provider_id") @db.Uuid
  status         String    // PENDING | RUNNING | COMPLETED | FAILED
  usersCreated   Int       @default(0) @map("users_created")
  usersUpdated   Int       @default(0) @map("users_updated")
  usersDisabled  Int       @default(0) @map("users_disabled")
  errorMessage   String?   @map("error_message") @db.Text
  startedAt      DateTime  @default(now()) @map("started_at")
  finishedAt     DateTime? @map("finished_at")

  organization Organization    @relation(fields: [organizationId], references: [id])
  provider     IdentityProvider @relation(fields: [providerId], references: [id])

  @@index([organizationId, startedAt])
  @@map("identity_sync_runs")
}

model Role {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  description    String?
  permissions    String[]  @default([])
  isSystemRole   Boolean   @default(false) @map("is_system_role")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  userRoles    UserRole[]
  identityGroupRoleMaps IdentityGroupRoleMap[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

model UserRole {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  assignedBy     String?  @map("assigned_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([organizationId])
  @@map("user_roles")
}

model Department {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  headUserId     String?   @map("head_user_id") @db.Uuid
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  headUser     User?        @relation("DepartmentHead", fields: [headUserId], references: [id])
  dataAssets   DataAsset[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("departments")
}

model Framework {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  name            String
  status          FrameworkStatus @default(DRAFT)
  industryProfile String?         @map("industry_profile")
  maturityLevel   String?         @map("maturity_level")
  isSdf           Boolean         @default(false) @map("is_sdf")
  roadmapJson     Json?           @map("roadmap_json")
  publishedAt     DateTime?       @map("published_at")
  createdBy       String?         @map("created_by") @db.Uuid
  updatedBy       String?         @map("updated_by") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")

  organization Organization  @relation(fields: [organizationId], references: [id])
  controls     Control[]
  requirements Requirement[]

  @@index([organizationId, status])
  @@map("frameworks")
}

model Control {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  frameworkId    String        @map("framework_id") @db.Uuid
  code           String
  title          String
  description    String?
  phase          String?
  sdfOverlay     Boolean       @default(false) @map("sdf_overlay")
  ownerUserId    String?       @map("owner_user_id") @db.Uuid
  dueAt          DateTime?     @map("due_at")
  status         ControlStatus @default(NOT_STARTED)
  legalBasisRef  String?       @map("legal_basis_ref")
  createdBy      String?       @map("created_by") @db.Uuid
  updatedBy      String?       @map("updated_by") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  organization      Organization      @relation(fields: [organizationId], references: [id])
  framework         Framework         @relation(fields: [frameworkId], references: [id])
  requirements      Requirement[]
  evidenceFiles     EvidenceFile[]
  violations        Violation[]
  remediationTasks  RemediationTask[]

  @@unique([frameworkId, code])
  @@index([organizationId, frameworkId])
  @@map("controls")
}

model Requirement {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  frameworkId    String            @map("framework_id") @db.Uuid
  controlId      String?           @map("control_id") @db.Uuid
  code           String
  title          String
  description    String?
  legalBasisRef  String?           @map("legal_basis_ref")
  status         RequirementStatus @default(NOT_STARTED)
  createdBy      String?           @map("created_by") @db.Uuid
  updatedBy      String?           @map("updated_by") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  deletedAt      DateTime?         @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  framework    Framework    @relation(fields: [frameworkId], references: [id])
  control      Control?     @relation(fields: [controlId], references: [id])

  @@unique([frameworkId, code])
  @@index([organizationId, frameworkId])
  @@map("requirements")
}

model RefreshSession {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @map("token_hash")
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  userAgent      String?   @map("user_agent")
  ipAddress      String?   @map("ip_address")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_sessions")
}

model OutboxEvent {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  eventType      String    @map("event_type")
  payload        Json
  actorUserId    String?   @map("actor_user_id") @db.Uuid
  correlationId  String?   @map("correlation_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  publishedAt    DateTime? @map("published_at")
  attempts       Int       @default(0)
  lockedAt       DateTime? @map("locked_at")
  lockToken      String?   @map("lock_token")
  availableAt    DateTime? @map("available_at")
  lastError      String?   @map("last_error") @db.Text

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([publishedAt, createdAt])
  @@index([organizationId])
  @@index([availableAt, publishedAt])
  @@map("outbox_events")
}

// =============================================================================
// Developer B / C tables — owned by other streams; add via their migrations.
// Placeholders (do not implement here):
//   data_assets, processing_activities, notices, consent_records,
//   data_subject_requests, validation_rules, validation_runs, validation_results,
//   violations, remediation_tasks, evidence_files, reports, notifications,
//   ai_usage_logs, audit_logs
// =============================================================================

// =============================================================================
// Developer B — Inventory
// =============================================================================

enum DataAssetStatus {
  ACTIVE
  ARCHIVED
}

enum DataSensitivity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model DataAsset {
  id String @id @default(uuid()) @db.Uuid

  organizationId String  @map("organization_id") @db.Uuid
  departmentId   String? @map("department_id") @db.Uuid
  ownerUserId    String? @map("owner_user_id") @db.Uuid

  assetName   String          @map("asset_name")
  assetType   String          @map("asset_type")
  category    String
  sensitivity DataSensitivity

  description String?

  storageLocation String? @map("storage_location")
  retentionPeriod String? @map("retention_period")
  source          DataAssetSource @default(MANUAL)
  systemId        String?         @map("system_id") @db.Uuid
  agentId         String?         @map("agent_id") @db.Uuid
  fieldSchemaJson Json?           @map("field_schema_json")
  piiTagsJson     Json?           @map("pii_tags_json")
  lastDiscoveredAt DateTime?      @map("last_discovered_at")

  status DataAssetStatus @default(ACTIVE)

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  department Department? @relation(fields: [departmentId], references: [id])

  owner User? @relation("DataAssetOwner", fields: [ownerUserId], references: [id])

  processingActivities ProcessingActivity[]
  consentRecords       ConsentRecord[]
  system               DataSystem? @relation(fields: [systemId], references: [id])
  agent                Agent? @relation(fields: [agentId], references: [id])
  dataFields           DataField[]
  complianceFindings   ComplianceFinding[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([departmentId])
  @@index([systemId])
  @@index([agentId])
  @@map("data_assets")
}

model ProcessingActivity {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid
  dataAssetId    String @map("data_asset_id") @db.Uuid
  vendorId       String? @map("vendor_id") @db.Uuid

  purpose       String
  sourceSystem  String? @map("source_system")
  recipientType String? @map("recipient_type")
  processorName String? @map("processor_name")
  legalBasis    String? @map("legal_basis")
  retentionRule String? @map("retention_rule")
  notes         String?

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  dataAsset DataAsset @relation(fields: [dataAssetId], references: [id])
  vendor    Vendor?   @relation(fields: [vendorId], references: [id])

  @@index([organizationId])
  @@index([dataAssetId])
  @@index([vendorId])
  @@map("processing_activities")
}

// =============================================================================
// Vendors — TPRM / SCRM
// =============================================================================

enum VendorType {
  PROCESSOR
  SUB_PROCESSOR
  JOINT
  OTHER
}

enum VendorCriticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum VendorStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  OFFBOARDED
}

enum VendorRelationshipType {
  SUB_PROCESSOR
  AFFILIATE
  RESELLER
  OTHER
}

enum VendorAgreementStatus {
  DRAFT
  ACTIVE
  EXPIRED
  SUPERSEDED
}

enum VendorDiligenceOutcome {
  APPROVED
  CONDITIONAL
  REJECTED
  PENDING
}

enum ErasureChecklistStatus {
  PENDING
  IN_PROGRESS
  DONE
  SKIPPED
  FAILED
}

model Vendor {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  name              String
  legalName         String?            @map("legal_name")
  vendorType        VendorType         @default(PROCESSOR) @map("vendor_type")
  countries         String[]           @default([])
  services          String?
  dataCategories    String[]           @default([]) @map("data_categories")
  criticality       VendorCriticality  @default(MEDIUM)
  status            VendorStatus       @default(DRAFT)
  inherentRiskScore Int?               @map("inherent_risk_score")
  residualRiskScore Int?               @map("residual_risk_score")
  nextReviewAt      DateTime?          @map("next_review_at")
  ownerUserId       String?            @map("owner_user_id") @db.Uuid
  notes             String?

  version Int @default(1)

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  owner        User?        @relation("VendorOwner", fields: [ownerUserId], references: [id])

  processingActivities ProcessingActivity[]
  agreements           VendorAgreement[]
  reviews              VendorDiligenceReview[]
  parentRelationships  VendorRelationship[] @relation("VendorParent")
  childRelationships   VendorRelationship[] @relation("VendorChild")
  erasureChecklistItems ErasureChecklistItem[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, criticality])
  @@map("vendors")
}

model VendorRelationship {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid
  parentVendorId String @map("parent_vendor_id") @db.Uuid
  childVendorId  String @map("child_vendor_id") @db.Uuid

  relationshipType      VendorRelationshipType @map("relationship_type")
  personalDataFlows     Boolean                @default(true) @map("personal_data_flows")
  notificationRequired  Boolean                @default(true) @map("notification_required")
  acknowledgedAt        DateTime?              @map("acknowledged_at")
  notes                 String?

  createdBy String? @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  parentVendor Vendor @relation("VendorParent", fields: [parentVendorId], references: [id])
  childVendor  Vendor @relation("VendorChild", fields: [childVendorId], references: [id])

  @@unique([parentVendorId, childVendorId])
  @@index([organizationId])
  @@map("vendor_relationships")
}

model VendorAgreement {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid
  vendorId       String @map("vendor_id") @db.Uuid

  title                    String
  versionLabel             String               @map("version_label")
  status                   VendorAgreementStatus @default(DRAFT)
  effectiveFrom            DateTime?            @map("effective_from")
  expiresAt                DateTime?            @map("expires_at")
  storageKey               String?              @map("storage_key")
  evidenceFileId           String?              @map("evidence_file_id") @db.Uuid
  allowsSubProcessors      Boolean              @default(false) @map("allows_sub_processors")
  crossBorderAllowed       Boolean              @default(false) @map("cross_border_allowed")
  breachNotifyHours        Int?                 @map("breach_notify_hours")
  notes                    String?

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
