enum RemediationTaskStatus {
  PENDING
  IN_PROGRESS
  PENDING_VERIFICATION
  VERIFIED
  CLOSED
  CANCELLED
}

enum RemediationTaskSource {
  AUTO
  MANUAL
}

model RemediationTask {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid
  violationId    String @map("violation_id") @db.Uuid
  controlId      String? @map("control_id") @db.Uuid

  /**
   * AUTO = created from a ViolationCreated event; MANUAL = user-created.
   */
  source RemediationTaskSource @default(MANUAL)

  taskTitle       String                @map("task_title")
  taskDescription String?               @map("task_description")
  status          RemediationTaskStatus @default(PENDING)
  assignedTo      String?               @map("assigned_to") @db.Uuid

  dueAt      DateTime? @map("due_at")
  verifiedAt DateTime? @map("verified_at")
  verifiedBy String?   @map("verified_by") @db.Uuid
  closedAt   DateTime? @map("closed_at")

  verificationNotes String? @map("verification_notes")
  resolutionSummary String? @map("resolution_summary")

  version Int @default(1)

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  violation    Violation    @relation(fields: [violationId], references: [id])
  control      Control?     @relation(fields: [controlId], references: [id])
  assignee     User?        @relation("RemediationTaskAssignee", fields: [assignedTo], references: [id])

  // NOTE: the at-most-one-AUTO-task-per-violation invariant is enforced by a
  // PARTIAL unique index in the migration SQL (Prisma cannot express partial
  // indexes). Do not add a full @@unique here or manual multi-task creation
  // per violation would be blocked.
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([assignedTo])
  @@index([violationId])
  @@map("remediation_tasks")
}

