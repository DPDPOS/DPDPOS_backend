  sourceType        String   @map("source_type")
  location          String
  findingType       String   @map("finding_type")
  excerpt           String?  @db.Text
  confidence        Float
  controlCandidates String[] @map("control_candidates")
  sourceHash        String?  @map("source_hash")
  createdAt         DateTime @default(now()) @map("created_at")

  assessment Assessment @relation(fields: [assessmentId], references: [id])
  scanJob    ScanJob    @relation(fields: [scanJobId], references: [id])

  @@index([assessmentId, versionNumber])
  @@index([scanJobId])
  @@index([organizationId])
  @@map("cli_findings")
}

model AssessmentControlResult {
  id             String            @id @default(uuid()) @db.Uuid
  assessmentId   String            @map("assessment_id") @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  versionNumber  Int               @map("version_number")
  controlCode    String            @map("control_code")
  status         ControlEvalStatus
  severity       String            @default("MEDIUM")
  reasoning      String            @db.Text
  evidenceRefs   Json              @default("[]") @map("evidence_refs")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  assessment Assessment @relation(fields: [assessmentId], references: [id])

  @@unique([assessmentId, versionNumber, controlCode])
  @@index([organizationId])
  @@map("assessment_control_results")
}

model AssessmentReport {
  id             String   @id @default(uuid()) @db.Uuid
  assessmentId   String   @map("assessment_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  versionNumber  Int      @map("version_number")
  score          Float
  summary        Json
  results        Json
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  assessment Assessment @relation(fields: [assessmentId], references: [id])

  @@unique([assessmentId, versionNumber])
  @@index([organizationId])
  @@map("assessment_reports")
}

model AssessmentAuditEvent {
  id             String              @id @default(uuid()) @db.Uuid
  assessmentId   String              @map("assessment_id") @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  actorUserId    String?             @map("actor_user_id") @db.Uuid
  actorType      AssessmentActorType @map("actor_type")
  action         String
  objectType     String              @map("object_type")
  objectId       String?             @map("object_id")
  payloadHash    String              @map("payload_hash")
  eventHash      String              @map("event_hash")
  prevEventHash  String?             @map("prev_event_hash")
  createdAt      DateTime            @default(now()) @map("created_at")

  assessment Assessment @relation(fields: [assessmentId], references: [id])

  @@index([assessmentId, createdAt])
  @@index([organizationId])
  @@map("assessment_audit_events")
}
