NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Public URLs (OIDC redirect + frontend SSO exchange + CLI mint instructions)
# Local: use localhost (Entra rejects http://127.0.0.1 as a redirect URI).
# Production: https://<api-host> and https://<vercel-host> — see docs/14_deployment.md
API_PUBLIC_URL=http://localhost:3000
FRONTEND_PUBLIC_URL=http://localhost:3001

# PostgreSQL
DATABASE_URL=postgresql://dpdpos:dpdpos@localhost:5432/dpdpos?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# S3-compatible (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=dpdpos-evidence
S3_FORCE_PATH_STYLE=true

# Outbox relay
OUTBOX_POLL_INTERVAL_MS=2000

# Server-side Groq AI (used by assessment AI jobs — keep key SECRET, never expose to CLI/client)
AI_API_KEY=your_groq_api_key_here
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=allam-2-7b
AI_MAX_TOKENS=1024

# Email OTP MFA — local MailHog (open http://localhost:8025 to see messages)
EMAIL_PROVIDER=MAILHOG
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_AUTH=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@dpdpos.local
EMAIL_WORKER_CONCURRENCY=10
# Global across all email-worker replicas; set from the SES account's send quota.
EMAIL_RATE_LIMIT_MAX=10
EMAIL_RATE_LIMIT_DURATION_MS=1000

AUTH_MFA_ENABLED=false  #true or false