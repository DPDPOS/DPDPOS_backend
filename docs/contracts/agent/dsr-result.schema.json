{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dpdpos.example/schemas/agent/dsr-result.schema.json",
  "title": "DSRResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "resultId", "taskId", "dedupeKey", "operation", "status", "startedAt", "completedAt", "systems", "resultHash"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "resultId": { "type": "string", "format": "uuid" },
    "taskId": { "type": "string", "format": "uuid" },
    "dedupeKey": { "type": "string", "minLength": 1, "maxLength": 512 },
    "operation": { "enum": ["ACCESS", "CORRECTION", "ERASURE"] },
    "status": { "enum": ["SUCCEEDED", "PARTIAL", "FAILED"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "systems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["systemExternalId", "status"],
        "properties": {
          "systemExternalId": { "type": "string", "minLength": 1, "maxLength": 512 },
          "status": { "enum": ["SUCCEEDED", "SKIPPED", "FAILED"] },
          "rowsMatched": { "type": "integer", "minimum": 0 },
          "rowsAffected": { "type": "integer", "minimum": 0 },
          "proof": { "type": "object", "additionalProperties": true },
          "failureReason": { "type": "string", "maxLength": 8192 }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "FAILED" } }, "required": ["status"] },
            "then": { "required": ["failureReason"] }
          }
        ]
      }
    },
    "outputArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256"],
      "properties": {
        "uri": { "type": "string", "format": "uri", "maxLength": 4096 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "resultHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
