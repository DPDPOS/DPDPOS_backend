{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dpdpos.example/schemas/agent/dsr-task.schema.json",
  "title": "DSRTask",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "requestId", "dedupeKey", "operation", "issuedAt", "expiresAt", "scope", "subject", "instructions"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "taskId": { "type": "string", "format": "uuid" },
    "requestId": { "type": "string", "format": "uuid" },
    "dedupeKey": { "type": "string", "minLength": 1, "maxLength": 512 },
    "operation": { "enum": ["ACCESS", "CORRECTION", "ERASURE"] },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "scope": { "$ref": "#/$defs/scopeProfile" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lookupTokens"],
      "properties": {
        "lookupTokens": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "token"],
            "properties": {
              "type": { "type": "string", "minLength": 1, "maxLength": 64 },
              "token": { "type": "string", "minLength": 1, "maxLength": 4096 }
            }
          }
        }
      }
    },
    "instructions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "scopeProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["systemAllowlist", "dataClassAllowlist", "operations", "environmentAllowlist"],
      "properties": {
        "systemAllowlist": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "dataClassAllowlist": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "operations": {
          "type": "array",
          "items": { "enum": ["DISCOVERY", "READ", "CORRECT", "ERASE", "CONSENT_SYNC"] },
          "uniqueItems": true
        },
        "environmentAllowlist": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "rowFilters": {
          "type": "object",
          "additionalProperties": { "type": "string", "maxLength": 4096 }
        }
      }
    }
  }
}
