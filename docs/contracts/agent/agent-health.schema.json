{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dpdpos.example/schemas/agent/agent-health.schema.json",
  "title": "AgentHealth",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "agentId", "observedAt", "status", "agentVersion", "uptimeSeconds", "pluginStatuses", "queueDepth"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "agentId": { "type": "string", "format": "uuid" },
    "observedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["HEALTHY", "DEGRADED", "UNHEALTHY"] },
    "agentVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "uptimeSeconds": { "type": "integer", "minimum": 0 },
    "pluginStatuses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "version", "status"],
        "properties": {
          "key": { "type": "string", "minLength": 1, "maxLength": 256 },
          "version": { "type": "string", "minLength": 1, "maxLength": 64 },
          "status": { "enum": ["READY", "DEGRADED", "FAILED"] },
          "message": { "type": "string", "maxLength": 2048 }
        }
      }
    },
    "queueDepth": { "type": "integer", "minimum": 0 },
    "lastDiscoveryAt": { "type": "string", "format": "date-time" },
    "metrics": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$" },
      "additionalProperties": { "type": "number" }
    }
  }
}
